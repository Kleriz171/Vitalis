{
  "expo": {
    "name": "Vitalis",
    "slug": "vitalis-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitalis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.vitalis.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.vitalis.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vitalis uses your location to send your SOS and to show help nearby.",
          "locationAlwaysAndWhenInUsePermission": "While you are on duty as a responder, Vitalis uses your location in the background so SOS calls near you can reach you, even with the app closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#101517"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14A897"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
