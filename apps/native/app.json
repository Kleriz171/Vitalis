{
  "expo": {
    "name": "Vitalis",
    "slug": "vitalis-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitalis",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.vitalis.native",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vitalis uses your location to broadcast SOS emergencies to nearby responders."
      }
    },
    "android": {
      "package": "dev.vitalis.native",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Vitalis uses your location to broadcast SOS emergencies to nearby responders." }],
      ["expo-splash-screen", {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#F7F5F0"
      }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
