# Copy to `.env` (or `.env.local`) and adjust for your machine.
# All vars MUST start with EXPO_PUBLIC_ to be visible to the client at build time.

# REST API base URL. Use your laptop's LAN IP when running on a physical device.
#   iOS Simulator:        http://localhost:4000/api
#   Android Emulator:     http://10.0.2.2:4000/api
#   Physical device:      http://<your-laptop-LAN-ip>:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Optional: explicit Socket.io URL. If unset, it's derived from EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Set to "true" to log every request to the Metro console. Only honored in dev.
EXPO_PUBLIC_DEBUG_NET=false
